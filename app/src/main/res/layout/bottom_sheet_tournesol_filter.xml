<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_tournesol"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <ImageView
                android:id="@+id/button_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cancel"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/filter_languages"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_en"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:tag="en"
                android:text="@string/language_english"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_fr"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="fr"
                android:text="@string/language_french"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_es"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="es"
                android:text="@string/language_spanish"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_de"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="de"
                android:text="@string/language_german"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_it"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="it"
                android:text="@string/language_italian"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pt"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="pt"
                android:text="@string/language_portuguese"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/filter_date"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_forever"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:tag="forever"
                android:text="@string/date_since_forever"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_year"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="year"
                android:text="@string/date_last_year"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_3_months"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="3_months"
                android:text="@string/date_last_3_months"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="month"
                android:text="@string/date_last_month"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_week"
                style="@style/Widget.NewPipe.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="week"
                android:text="@string/date_last_week"
                app:chipBackgroundColor="@color/tournesol_chip_background_color" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
