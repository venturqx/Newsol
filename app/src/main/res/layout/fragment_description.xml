<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:scrollbars="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="#0F0F0F">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/detail_upload_date_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/video_item_detail_upload_date_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/detail_select_description_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tournesol_criteria_section"
            tools:text="Published on Oct 2, 2009" />

        <ImageView
            android:id="@+id/detail_select_description_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/description_select_enable"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_select_all"
            app:layout_constraintBottom_toBottomOf="@+id/detail_upload_date_view"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/detail_upload_date_view" />

        <!-- Tournesol info section (shown when data is available) -->
        <LinearLayout
            android:id="@+id/tournesol_info_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_tournesol_section"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <!-- Section header: SCORES -->
            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/tournesol_section_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="SCORES"
                android:textAllCaps="true"
                android:textColor="#DBB222"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Score + stats row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/tournesol_logo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo_small" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/tournesol_unsafe_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/tournesol_score_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:textColor="#FFCA1D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="56.7" />

                <!-- Distribution chart (compact, inline right of score) -->
                <LinearLayout
                    android:id="@+id/tournesol_distribution_container"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Contributors + comparisons stacked on the right -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <org.schabi.newpipe.views.NewPipeTextView
                        android:id="@+id/tournesol_contributors"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/video_item_detail_description_text_size"
                        tools:text="30 contributors" />

                    <org.schabi.newpipe.views.NewPipeTextView
                        android:id="@+id/tournesol_comparisons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/video_item_detail_description_text_size"
                        tools:text="113 comparisons" />

                </LinearLayout>

            </LinearLayout>

            <!-- Unsafe warning (shown only when flagged) -->
            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/tournesol_unsafe_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/video_item_detail_description_text_size"
                android:visibility="gone"
                tools:text="⚠ Flagged as unsafe" />

        </LinearLayout>

        <!-- Tournesol criteria section (lollipop chart) -->
        <LinearLayout
            android:id="@+id/tournesol_criteria_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tournesol_section"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tournesol_info_section"
            tools:visibility="visible">

            <!-- Section header: CRITERIA -->
            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/tournesol_criteria_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="CRITERIA"
                android:textAllCaps="true"
                android:textColor="#DBB222"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Lollipop chart (populated dynamically) -->
            <FrameLayout
                android:id="@+id/tournesol_lollipop_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierAllowsGoneWidgets="false"
            app:barrierDirection="top"
            app:constraint_referenced_ids="detail_description_note_view,detail_description_view" />

        <!-- Section header: DESCRIPTION -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/description_section_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="DESCRIPTION"
            android:textAllCaps="true"
            android:textColor="#DBB222"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detail_upload_date_view" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/detail_description_note_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="@string/description_select_note"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/description_section_header"
            tools:visibility="visible" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/detail_description_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/video_item_detail_description_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detail_description_note_view"
            tools:text="Description Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed a ultricies ex. Integer sit amet sodales risus. Duis non mi et urna pretium bibendum." />

        <LinearLayout
            android:id="@+id/detail_metadata_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/detail_description_view" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
